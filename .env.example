# ==============================================================================
# COORDINA ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: DO NOT COMMIT REAL KEYS OR SECRETS TO GITHUB.
# All environment variables must be configured in your Vercel Project Settings:
# Vercel Dashboard -> Project Settings -> Environment Variables
# ==============================================================================

# 1. Convex Backend Deployment URLs (Frontend & Realtime Engine)
VITE_CONVEX_URL=https://sensible-elephant-183.eu-west-1.convex.cloud
VITE_CONVEX_SITE_URL=https://sensible-elephant-183.eu-west-1.convex.site

# 2. Resend Transactional Email Service (Vercel Serverless Function & Web)
RESEND_API_KEY=
VITE_RESEND_API_KEY=
RESEND_FROM_EMAIL=COORDINA <onboarding@resend.dev>
VITE_RESEND_FROM_EMAIL=COORDINA <onboarding@resend.dev>

# 3. Paystack Payment Gateway Keys (Card, USSD & Bank Settlements)
VITE_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
VITE_PAYSTACK_SECRET_KEY=
