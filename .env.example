# Convex Backend Deployment URL
VITE_CONVEX_URL=

# Resend Transactional Email API Key
VITE_RESEND_API_KEY=

# Resend Sender Email (Default: COORDINA <onboarding@resend.dev> or custom verified domain)
VITE_RESEND_FROM_EMAIL=COORDINA <onboarding@resend.dev>

# Paystack Public Key for Checkout (Card, Transfer, USSD)
VITE_PAYSTACK_PUBLIC_KEY=

# Paystack Secret Key for Transfers, Bank Resolution & Payouts
VITE_PAYSTACK_SECRET_KEY=
