# ==============================================================================
# COORDINA ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================
# IMPORTANT: DO NOT COMMIT REAL KEYS OR SECRETS TO GITHUB.
# Configure these variables in Vercel Dashboard -> Project Settings -> Environment Variables
# ==============================================================================

# 1. Convex Backend Deployment URLs (Public Client Endpoints)
VITE_CONVEX_URL=https://sensible-elephant-183.eu-west-1.convex.cloud
VITE_CONVEX_SITE_URL=https://sensible-elephant-183.eu-west-1.convex.site

# 2. SendGrid Transactional Email Service (Server-Only — Vercel Serverless & Convex Env)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=COORDINA <apvdirect1@gmail.com>

# 3. Paystack Payment Gateway
# Public key is safe for browser Paystack Inline checkout
VITE_PAYSTACK_PUBLIC_KEY=
# Secret key MUST stay server-only (used exclusively by /api/paystack)
PAYSTACK_SECRET_KEY=
